# Copy this file to `.env` in this folder and adjust as needed. `.env` is git-ignored.
# Every value below is optional for local development — the defaults shown just work.

# Browser origins allowed to call the API (/api/*). Comma-separated, no trailing slash.
# Add your deployed frontend's URL here when you host the app somewhere.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only needed to re-download the Cow Mastitis training photos
# (python -m training.fetch_mastitis_data). Free key from https://roboflow.com — leave empty
# otherwise. Never commit a real key.
ROBOFLOW_API_KEY=

# Port for the Docker image's start command (hosting platforms usually set this for you).
# Not used by `uvicorn ... --port 8000` when you run it yourself.
# PORT=8000
